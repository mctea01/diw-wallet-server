# Copy to .env and fill in. The domain's DNS A/AAAA record must point at this host before the first start.
DIW_DOMAIN=diw.example.org
DIW_ACME_EMAIL=admin@example.org
# Optional: pin an image version instead of latest, and change the enabled features.
# DIW_VERSION=0.1.0
# DIW_FEATURES=relay,bonds-age,verifier
# With zktls in DIW_FEATURES: SHA-256 of the access token the wallet sends. Print it with
#   docker compose run --rm server hash-token
# DIW_FEATURES=relay,zktls,bonds-age
# DIW_ZKTLS_TOKEN_SHA256=<64 hex>
