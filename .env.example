# Optional; only compose.yaml reads this file. Every server setting lives in server.conf (deploy/server.conf.example),
# the same file a manual install, Cloud Run and Cloudflare use.
# Image tag: a release version, latest, or <version>-native for the experimental GraalVM native image.
# DIW_VERSION=latest
# DIW_MEMORY_LIMIT=700m
# DIW_JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m
