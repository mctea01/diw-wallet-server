# DIW wallet server settings: one file for every deployment (generated by diw-server config-template).
# - Without containers: /etc/diw-server/server.conf, or the systemd unit's EnvironmentFile.
# - compose.yaml: ./server.conf, read as env_file by the server and Caddy.
# - Cloud Run: the Secret Manager secret diw-server-conf, mounted at /etc/diw-server/server.conf.
# - Cloudflare Containers: the Worker secret SERVER_CONF (wrangler secret put SERVER_CONF < server.conf).
# Each line is DIW_<KEY>=value without quotes (lower-case key=value is read too). An environment variable of
# the same name overrides the file. Unknown keys stop the start. Keep this file mode 0600 when it holds secrets.

# --- General ---
# Address wallets use, e.g. https://diw.example.org; session links, relay and web verifier URLs are built from it.
DIW_PUBLIC_URL=https://diw.example.org
# Enabled features, comma separated: relay, zktls, bonds-age, verifier, twfido, federation, oprf, zkpassport. Default: relay.
# DIW_FEATURES=relay
# Contact address for the certificate authority; read by the bundled Caddy configuration, not by the server.
# DIW_ACME_EMAIL=admin@example.org

# --- Deployment (platform defaults apply when unset) ---
# Address to listen on; containers default to 0.0.0.0. Default: 127.0.0.1.
# DIW_LISTEN_HOST=127.0.0.1
# Port to listen on; PORT is used when this is unset (Cloud Run). Default: 8080.
# DIW_LISTEN_PORT=8080
# Data directory: native library, keys, template cache. Default: /var/lib/diw-server.
# DIW_DATA_DIR=/var/lib/diw-server
# Take the client address from X-Forwarded-For; defaults to true on loopback and behind the platform's own proxy.
# DIW_TRUST_FORWARDED=

# --- Relay ---
# Rooms at once. Default: 64.
# DIW_RELAY_MAX_ROOMS=64
# Lifetime of one room. Default: 15.
# DIW_RELAY_LIFETIME_MINUTES=15
# Traffic of one room, both ways. Default: 256.
# DIW_RELAY_MAX_MB=256
# Largest frame. Default: 128.
# DIW_RELAY_MAX_FRAME_KB=128
# Connections from one client address. Default: 8.
# DIW_RELAY_PER_ADDRESS=8

# --- zkTLS verifier host (features=zktls) ---
# SHA-256 of the access tokens, comma separated (diw-server hash-token prints one); required with zktls.
# DIW_ZKTLS_TOKEN_SHA256=<64 hex>
# Sessions at once. Default: 16.
# DIW_ZKTLS_MAX_SESSIONS=16
# Sessions from one client address. Default: 4.
# DIW_ZKTLS_PER_ADDRESS=4
# Verifications running at once. Default: 1.
# DIW_ZKTLS_CONCURRENT=1
# Local signed template pack instead of the project's release (still checked against the pinned key).
# DIW_ZKTLS_TEMPLATES_FILE=
# PEM public keys also accepted for template packs (a private pack); wallets still take pages only from their own pack outside the test environment.
# DIW_ZKTLS_TEMPLATE_KEYS_FILE=
# PEM file of extra server roots accepted for proved pages (an intranet or test host).
# DIW_ZKTLS_EXTRA_ROOTS_FILE=

# --- Keys (zktls signing key; signing_generate also covers the federation key) ---
# PEM file with the signing key and its chain; defaults to data_dir/signing.pem.
# DIW_SIGNING_KEY_FILE=
# The same PEM inline, \n for line breaks (a platform secret); wins over the file. Secret.
# DIW_SIGNING_KEY_PEM=
# Make missing keys on the first start; set false where the disk is not kept. Default: true.
# DIW_SIGNING_GENERATE=true

# --- Web verifier (features=verifier) ---
# Name on the holder's consent screen. Default: DIW 網頁查驗.
# DIW_VERIFIER_NAME=DIW 網頁查驗
# Access code the page asks for (at least 8 characters); unset lets anyone use it. Secret.
# DIW_VERIFIER_ACCESS_TOKEN=
# Directory of the verifier key; defaults to data_dir/verifier.
# DIW_VERIFIER_KEY_DIR=
# The verifier key PEM inline (a platform secret); wins over the directory. Secret.
# DIW_VERIFIER_KEY_PEM=
# Verifications at once. Default: 64.
# DIW_VERIFIER_MAX_SESSIONS=64
# Verifications from one client address. Default: 8.
# DIW_VERIFIER_PER_ADDRESS=8

# --- Bonds age host (features=bonds-age) ---
# Requests at once. Default: 64.
# DIW_BONDS_AGE_MAX_SESSIONS=64
# Requests from one client address. Default: 8.
# DIW_BONDS_AGE_PER_ADDRESS=8
# Verify proofs here (needs OpenAC and about 2 GB of memory); otherwise relay only. Default: false.
# DIW_BONDS_AGE_VERIFY=false

# --- Mobile citizen certificate signing (features=twfido) ---
# production or uat; both need an SP account from the Ministry of the Interior. Default: production.
# DIW_TWFIDO_ENVIRONMENT=production
# SP service ID; required with twfido.
# DIW_TWFIDO_SERVICE_ID=
# SP AES key, base64 of 32 bytes; required with twfido. Secret.
# DIW_TWFIDO_AES_KEY=
# SHA-256 of the signing access tokens; defaults to zktls_token_sha256.
# DIW_TWFIDO_TOKEN_SHA256=
# Requests at once. Default: 16.
# DIW_TWFIDO_MAX_SESSIONS=16
# Requests from one client address. Default: 4.
# DIW_TWFIDO_PER_ADDRESS=4
# Requests for one ID number (counted by hash). Default: 2.
# DIW_TWFIDO_PER_ID=2

# --- OpenID Federation (features=federation) ---
# Entity Identifier; defaults to public_url.
# DIW_FEDERATION_ENTITY_ID=
# Superior entities (intermediates or Trust Anchors), comma separated.
# DIW_FEDERATION_AUTHORITY_HINTS=
# Trust Mark JWTs issued to this server, comma separated.
# DIW_FEDERATION_TRUST_MARKS=
# organization_name in the federation_entity metadata; defaults to verifier_name.
# DIW_FEDERATION_ORGANIZATION_NAME=
# PEM file of the federation entity key; defaults to data_dir/federation.pem.
# DIW_FEDERATION_KEY_FILE=
# The federation key PEM inline (a platform secret); wins over the file. Secret.
# DIW_FEDERATION_KEY_PEM=
# JSON file of subordinate entities; makes this server an intermediate or Trust Anchor (fetch and list endpoints).
# DIW_FEDERATION_SUBORDINATES_FILE=
# Validity of the statements this server signs. Default: 24.
# DIW_FEDERATION_LIFETIME_HOURS=24

# --- Project OPRF for zkPassport salted identifiers (features=oprf) ---
# OPRF key, a BabyJubJub scalar (diw-server oprf-keygen prints one); required with oprf. Secret.
# DIW_OPRF_KEY=
# Id published with the public key; change it when the key is rotated. Default: 1.
# DIW_OPRF_KEY_ID=1
# SHA-256 of the evaluation access tokens; defaults to zktls_token_sha256.
# DIW_OPRF_TOKEN_SHA256=
# Evaluations from one client address per hour. Default: 20.
# DIW_OPRF_PER_ADDRESS=20
# Evaluations in all per hour. Default: 2000.
# DIW_OPRF_TOTAL=2000

# --- Own zkPassport prover (features=zkpassport) ---
# SHA-256 of the owner's tokens that may send passport data for proving; required with zkpassport and never one of zktls_token_sha256.
# DIW_ZKPASSPORT_TOKEN_SHA256=
# Jobs that may wait behind the one being proved. Default: 2.
# DIW_ZKPASSPORT_QUEUE=2
# Ethereum mainnet node for zkPassport's registries; defaults to the wallet's public node.
# DIW_ZKPASSPORT_RPC=
# Ethereum Sepolia node for test requests; defaults to the wallet's public node.
# DIW_ZKPASSPORT_SEPOLIA_RPC=
