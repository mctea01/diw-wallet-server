# Install: unpack the release bundle (diw-server-<version>-linux-x86_64.tar.gz, with its own Java runtime) to
# /opt/diw-server, copy this file to /etc/systemd/system/ and the config example to /etc/diw-server/server.conf,
# then: systemctl daemon-reload && systemctl enable --now diw-server
[Unit]
Description=DIW wallet server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=diw-server
ConfigurationDirectory=diw-server
Environment=DIW_DATA_DIR=/var/lib/diw-server
Environment="JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"
# Class data sharing archive made on the first start and remade after an upgrade; about halves start time.
Environment="JDK_JAVA_OPTIONS=-XX:+AutoCreateSharedArchive -XX:SharedArchiveFile=/var/lib/diw-server/diw-server.jsa"
ExecStart=/opt/diw-server/bin/diw-server
Restart=on-failure
RestartSec=5
MemoryMax=700M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
