# Install: unpack the release bundle (diw-server-<version>.tar, with its own Java runtime) to /opt/diw-server, copy
# this file to /etc/systemd/system/ and deploy/server.conf.example to /etc/diw-server/server.conf (the same settings
# file compose, Cloud Run and Cloudflare use), then: systemctl daemon-reload && systemctl enable --now diw-server
# The experimental native binary (diw-server-<version>-native) replaces bin/diw-server; JAVA_OPTS and the class data
# sharing line below then have no effect.
[Unit]
Description=DIW wallet server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=diw-server
ConfigurationDirectory=diw-server
Environment=DIW_PLATFORM=host
Environment="JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"
# Class data sharing archive made on the first start and remade after an upgrade; about halves start time.
Environment="JDK_JAVA_OPTIONS=-XX:+AutoCreateSharedArchive -XX:SharedArchiveFile=/var/lib/diw-server/diw-server.jsa"
ExecStart=/opt/diw-server/bin/diw-server
Restart=on-failure
RestartSec=5
MemoryMax=700M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
